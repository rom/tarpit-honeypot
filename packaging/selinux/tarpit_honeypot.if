## <summary>tarpit-honeypot deception sensor.</summary>

########################################
## <summary>
##	All of the rules required to administrate
##	the tarpit-honeypot data + log directories.
## </summary>
## <param name="role">
##	<summary>Role allowed access.</summary>
## </param>
## <param name="domain">
##	<summary>User domain for the role.</summary>
## </param>
#
interface(`tarpit_honeypot_admin',`
	gen_require(`
		type tarpit_honeypot_t, tarpit_honeypot_var_lib_t;
		type tarpit_honeypot_log_t, tarpit_honeypot_etc_t;
	')

	allow $1 tarpit_honeypot_t:process { signal_perms };
	ps_process_pattern($1, tarpit_honeypot_t)

	files_search_var_lib($1)
	admin_pattern($1, tarpit_honeypot_var_lib_t)
	admin_pattern($1, tarpit_honeypot_log_t)
	admin_pattern($1, tarpit_honeypot_etc_t)
')
