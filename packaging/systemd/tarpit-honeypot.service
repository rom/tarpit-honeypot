[Unit]
Description=tarpit-honeypot deception sensor
Documentation=https://github.com/rom/tarpit-honeypot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Must match the service account scripts/install.sh creates (honey:honeypot)
# and the owner of /var/lib/tarpit-honeypot, or the sensor can't write its
# state (e.g. .deployment-id) and won't start.
User=honey
Group=honeypot
ExecStart=/usr/local/bin/tarpit-honeypot run -c /etc/tarpit-honeypot/config.yaml
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5s

# Tag the daemon's stderr (its slog startup/warning output) under a stable
# syslog identity so the rsyslog drop-in (packaging/rsyslog/30-tarpit-honeypot
# .conf) can route it — together with the CEF event stream, which carries the
# same tag — into /var/log/tarpit-honeypot/ instead of /var/log/messages.
SyslogIdentifier=tarpit-honeypot

# Grant the capabilities the sensor needs even after privilege drop.
AmbientCapabilities=CAP_NET_BIND_SERVICE CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_NET_RAW
NoNewPrivileges=true

# Pin the SELinux domain explicitly. NoNewPrivileges=yes blocks the automatic
# init_t->tarpit_honeypot_t transition, so without this (or the policy's
# init_nnp_daemon_domain grant) the daemon runs unconfined. The leading '-'
# makes it non-fatal when SELinux is disabled or the policy module isn't
# installed, so the service still starts there.
SELinuxContext=-system_u:system_r:tarpit_honeypot_t:s0

# Hardening (complements the in-process seccomp + Landlock). Keep this in sync
# with the unit scripts/install.sh generates (scripts/install.sh) — the CI
# check in packaging/systemd/unit_hardening_test.go enforces that the key
# directives below are present in every shipped unit.
ProtectSystem=strict
ReadWritePaths=/var/lib/tarpit-honeypot /var/log/tarpit-honeypot
ReadOnlyPaths=/etc/tarpit-honeypot
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
RestrictNamespaces=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_PACKET AF_NETLINK
MemoryDenyWriteExecute=true
LockPersonality=true
SystemCallArchitectures=native
# NB: no SystemCallFilter allowlist — the sensor's in-process seccomp DENYLIST
# (sensor.sandbox.seccomp) blocks the dangerous syscalls precisely, without an
# allowlist that could block the in-process Landlock syscalls.

[Install]
WantedBy=multi-user.target
