[Unit]
Description=tarpit-honeypot deception sensor
Documentation=https://github.com/rom/tarpit-honeypot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Must match the service account scripts/install.sh creates (honey:honeypot)
# and the owner of /var/lib/tarpit-honeypot, or the sensor can't write its
# state (e.g. .deployment-id) and won't start.
User=honey
Group=honeypot
ExecStart=/usr/local/bin/tarpit-honeypot run -c /etc/tarpit-honeypot/config.yaml
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5s

# Grant the capabilities the sensor needs even after privilege drop.
AmbientCapabilities=CAP_NET_BIND_SERVICE CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_NET_RAW
NoNewPrivileges=true

# Pin the SELinux domain explicitly. NoNewPrivileges=yes blocks the automatic
# init_t->tarpit_honeypot_t transition, so without this (or the policy's
# init_nnp_daemon_domain grant) the daemon runs unconfined. The leading '-'
# makes it non-fatal when SELinux is disabled or the policy module isn't
# installed, so the service still starts there.
SELinuxContext=-system_u:system_r:tarpit_honeypot_t:s0

# Hardening.
ProtectSystem=strict
ReadWritePaths=/var/lib/tarpit-honeypot /var/log/tarpit-honeypot
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
LockPersonality=true
RestrictRealtime=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
