[Unit]
Description=tarpit-honeypot enrichment refresh (GeoIP / Tor / threat feeds)
Documentation=https://github.com/rom/tarpit-honeypot
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Runs as root: it writes /etc/tarpit-honeypot/enrichment and reloads the
# service. The honeypot itself still runs unprivileged (User=honey in
# tarpit-honeypot.service); this maintenance job is separate and short-lived.
ExecStart=/usr/local/share/tarpit-honeypot/scripts/update-enrichment.sh -c /etc/tarpit-honeypot/config.yaml
# Optional MaxMind GeoLite2 key (otherwise no-key DB-IP lite DBs are used):
# Environment=MAXMIND_LICENSE_KEY=xxxxxxxx

# Hardening for the maintenance job.
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/tarpit-honeypot /var/log/tarpit-honeypot /etc/tarpit-honeypot
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
LockPersonality=true
