[Unit]
Description=Refresh tarpit-honeypot enrichment data daily

[Timer]
# Daily, a few minutes after 04:00, with a random spread so a fleet doesn't
# hammer the feed mirrors at the same second. Catches up if the box was off.
OnCalendar=*-*-* 04:17:00
RandomizedDelaySec=900
Persistent=true

[Install]
WantedBy=timers.target
