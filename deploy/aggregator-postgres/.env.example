# Copy to .env and fill in. docker compose reads this automatically.
# Do NOT commit your real .env.

# PostgreSQL password for the tarpit DB user (used by both services).
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# Bearer token each leaf sensor must present when forwarding events. Set the
# leaves' TARPIT_FWD_TOKEN to this same value.
TARPIT_INGEST_TOKEN=change-me-to-a-long-random-token
